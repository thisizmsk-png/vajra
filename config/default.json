{
  "$schema": "vajra-config-v2",
  "schemaVersion": 2,
  "routing": {
    "comment": "Read by scripts/vajra_route.py (UserPromptSubmit hook). Patterns are Python regexes matched case-insensitively against the ask. Order is specificity: the most specific pattern comes first and the first match is the primary route. Each pattern names a cortex domain; the agent comes from cortex.agentRouting[domain].agent, so every route carries an agent.",
    "suggestOnAllPrompts": false,
    "maxSuggestions": 3,
    "maxPromptChars": 4000,
    "patterns": [
      { "id": "backtest",       "regex": "\\b(back-?test(s|ing)?|walk-?forward|overfit(ting)?)\\b",                                      "domain": "quant",        "skill": "backtest-validation" },
      { "id": "premortem",      "regex": "\\b(pre-?mortem|what could go wrong|failure modes?)\\b",                                         "domain": "premortem",    "skill": null },
      { "id": "acceptance",     "regex": "\\b(acceptance criteria|user stor(y|ies)|given[ /]when[ /]then)\\b",                           "domain": "acceptance",   "skill": "prd-to-issues" },
      { "id": "incident",       "regex": "\\b(incident|outage|sev ?[0-3]|(prod|production) (is )?(down|degraded))\\b",                   "domain": "incident",     "skill": "incident-response", "crew": "incident-response" },
      { "id": "security-audit", "regex": "\\b(security audit|pen-?test(ing)?|penetration test(ing)?)\\b",                                 "domain": "security",     "skill": "sentry-security-review", "crew": "security-audit" },
      { "id": "threat-model",   "regex": "\\bthreat[- ]?model(s|ing)?\\b",                                                                 "domain": "security",     "skill": "threat-modeling" },
      { "id": "exploit",        "regex": "\\b(exploit(s|able)?|proof[- ]of[- ]concept attack)\\b",                                         "domain": "pentest",      "skill": "sentry-security-review" },
      { "id": "security",       "regex": "\\b(security|vulnerab(le|ility|ilities)|xss|csrf|ssrf|sql injection|authz|secrets? leak)\\b",   "domain": "security",     "skill": "sentry-security-review" },
      { "id": "arch-review",    "regex": "\\b(architecture review|design review)\\b",                                                      "domain": "architecture", "skill": "hld", "crew": "architecture-review" },
      { "id": "tech-choice",    "regex": "\\b(build (vs\\.?|or) buy|tech(nology)? stack|which (framework|database|library)|should we (use|adopt|pick))\\b", "domain": "decision", "skill": "decision-journal", "crew": "sabha" },
      { "id": "fix-issue",      "regex": "\\bfix(es)?\\s+#\\d+\\b",                                                                         "domain": "backend",      "skill": "systematic-debugging" },
      { "id": "debug",          "regex": "\\b(debug(ging)?|stack ?trace|traceback|crash(es|ing)?|regression|flaky)\\b",                    "domain": "backend",      "skill": "systematic-debugging" },
      { "id": "ci-cd",          "regex": "\\b(ci/?cd|pipeline|github actions|terraform|kubernetes|k8s|dockerfile|deploy(ment|ing|s)?)\\b",  "domain": "devops",       "skill": "ci-cd" },
      { "id": "observability",  "regex": "\\b(observability|monitoring|slos?|alerting)\\b",                                                "domain": "devops",       "skill": "observability" },
      { "id": "release",        "regex": "\\b(release (notes|checklist|plan)|changelog|go/no-go)\\b",                                      "domain": "program",      "skill": "release-engineering" },
      { "id": "experiment",     "regex": "\\b(a/b test|experiment results?|statistical(ly)? significan(t|ce)|metrics analysis)\\b",        "domain": "data",         "skill": "data-analysis" },
      { "id": "prd",            "regex": "\\b(prd|product requirements|product spec|roadmap)\\b",                                          "domain": "product",      "skill": "product-spec" },
      { "id": "testing",        "regex": "\\b(unit tests?|integration tests?|e2e tests?|test coverage|write tests|add tests)\\b",           "domain": "testing",      "skill": "testing" },
      { "id": "code-review",    "regex": "\\breview (my |the |this )?(code|diff|pr|pull request|changes)\\b",                               "domain": "code",         "skill": "code-review" },
      { "id": "refactor",       "regex": "\\b(refactor(ing)?|simplify|clean ?up)\\b",                                                      "domain": "code",         "skill": "sentry-code-simplifier" },
      { "id": "architecture",   "regex": "\\b(architecture|system design|hld|lld|adr)\\b",                                                 "domain": "architecture", "skill": "hld" },
      { "id": "api",            "regex": "\\b(api|endpoints?|rest api|graphql|openapi)\\b",                                                    "domain": "backend",      "skill": "api-design" },
      { "id": "database",       "regex": "\\b(database|schema|migrations?|postgres(ql)?|mysql|sqlite)\\b",                                 "domain": "backend",      "skill": "database-design" },
      { "id": "performance",    "regex": "\\b(performance|latency|p99|profil(e|ing)|too slow)\\b",                                         "domain": "backend",      "skill": "performance-profiler" },
      { "id": "accessibility",  "regex": "\\b(accessibility|a11y|wcag)\\b",                                                                "domain": "frontend",     "skill": "audit" },
      { "id": "frontend",       "regex": "\\b(ui|frontend|front-end|component|css|react|landing page|web page|(login|signup|settings) (page|form|screen))\\b",                        "domain": "frontend",     "skill": "frontend-design" },
      { "id": "full-stack",     "regex": "\\b(full-?stack|end-to-end feature)\\b",                                                         "domain": "architecture", "skill": null, "crew": "feature-build" },
      { "id": "spike",          "regex": "\\b(spike|prototype|quick trial)\\b",                                                            "domain": "junior",       "skill": null },
      { "id": "trip",           "regex": "\\b(trip|itinerary|vacation|road ?trip)\\b",                                                     "domain": null,           "skill": "trip-planner" }
    ]
  },
  "security": {
    "comment": "Read by engine/sanitizer.ts, a reference implementation tested in CI that nothing calls at runtime. At runtime, wrapping untrusted content in <untrusted-data> is an instruction the model follows (SKILL.md); stripping patterns is best effort.",
    "sanitization": {
      "stripPatterns": [
        "ignore previous instructions",
        "ignore all previous",
        "disregard all prior",
        "you are now",
        "from now on you",
        "system prompt",
        "IMPORTANT:",
        "\\[INST\\]",
        "\\[/INST\\]",
        "<\\|im_start\\|>",
        "<\\|im_end\\|>",
        "<\\|endoftext\\|>",
        "<system>",
        "</system>",
        "\\[SYSTEM\\]",
        "<instructions>",
        "</instructions>",
        "Human:",
        "Assistant:",
        "###\\s*(System|User|Assistant)",
        "\\bBEGIN INJECTION\\b",
        "\\bEND INJECTION\\b"
      ],
      "maxContentLength": 50000,
      "escapeControlChars": true,
      "wrapInTags": true,
      "tagName": "untrusted-data"
    }
  },
  "cortex": {
    "comment": "Domain -> agent. Agents run through the Agent tool (subagent_type) or a workflow agentType, so each agent's own tools, model and effort apply. krishna is never a routing target.",
    "agentsDir": "~/.claude/agents",
    "deliverWorkflow": "vajra-deliver",
    "agentRouting": {
      "backend":      { "agent": "bhima",          "skills": ["api-design", "database-design", "performance-profiler", "systematic-debugging"] },
      "frontend":     { "agent": "nakula",         "skills": ["frontend-design", "ui-styling", "react-best-practices", "audit"] },
      "security":     { "agent": "bhishma",        "skills": ["threat-modeling", "sentry-security-review", "sentry-find-bugs"] },
      "pentest":      { "agent": "shakuni",        "skills": ["sentry-security-review", "entry-point-analyzer"] },
      "premortem":    { "agent": "duryodhana",     "skills": ["decision-journal"] },
      "testing":      { "agent": "vidura",         "skills": ["testing", "property-based-testing", "webapp-testing"] },
      "acceptance":   { "agent": "drona",          "skills": ["prd-to-issues", "product-spec"] },
      "devops":       { "agent": "hanuman",        "skills": ["ci-cd", "observability"] },
      "incident":     { "agent": "ashwatthama",    "skills": ["incident-response", "systematic-debugging"] },
      "product":      { "agent": "draupadi",       "skills": ["product-spec", "brainstorming", "research"] },
      "architecture": { "agent": "arjuna",         "skills": ["hld", "lld", "architecture-diagrams"] },
      "code":         { "agent": "arjuna",         "skills": ["code-review", "sentry-code-simplifier", "improve-codebase-architecture"] },
      "decision":     { "agent": "yudhishthira",   "skills": ["decision-journal", "research"] },
      "data":         { "agent": "sahadeva",       "skills": ["data-analysis"] },
      "quant":        { "agent": "karna",          "skills": ["backtest-validation", "data-analysis"] },
      "junior":       { "agent": "abhimanyu",      "skills": ["docs-validator"] },
      "program":      { "agent": "dhrishtadyumna", "skills": ["release-engineering", "writing-plans", "prd-to-issues"] }
    },
    "fleetCrews": {
      "feature-build":       { "workflow": "vajra-feature-build",       "lead": "arjuna",       "agents": ["bhima", "nakula", "vidura"],                       "description": "Feature build: design, backend and frontend writers in worktrees, independent verification and review" },
      "security-audit":      { "workflow": "vajra-security-audit",      "lead": "bhishma",      "agents": ["shakuni", "duryodhana", "vidura"],                 "description": "Security audit: threat model, exploit PoCs as failing tests, verification" },
      "incident-response":   { "workflow": "vajra-incident-response",   "lead": "ashwatthama",  "agents": ["hanuman", "bhima", "vidura"],                     "description": "Incident: triage, a reversible mitigation plan for approval, root-cause fix" },
      "architecture-review": { "workflow": "vajra-architecture-review", "lead": "yudhishthira", "agents": ["arjuna", "bhishma", "draupadi"],                  "description": "Architecture review: design, security and product perspectives, then a verdict" },
      "sabha":               { "workflow": "vajra-sabha",               "lead": "yudhishthira", "agents": ["arjuna", "bhishma", "draupadi", "duryodhana"],    "description": "Debate: positions, adversary pre-mortem, a vote counted in code, synthesis" }
    }
  }
}
