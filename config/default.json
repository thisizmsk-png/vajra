{
  "$schema": "vajra-config-v2",
  "schemaVersion": 2,
  "routing": {
    "comment": "Read by scripts/vajra_route.py (UserPromptSubmit hook). Patterns are Python regexes matched case-insensitively against the ask. Order is specificity: the most specific pattern comes first and the first match is the primary route. Each pattern names a cortex domain; the agent comes from cortex.agentRouting[domain].agent, so every route carries an agent.",
    "suggestOnAllPrompts": false,
    "maxSuggestions": 3,
    "maxPromptChars": 4000,
    "patterns": [
      {"id": "backtest", "regex": "\\b(back-?test(s|ing)?|walk-?forward|overfit(ting)?)\\b", "domain": "quant", "skill": "backtest-validation"},
      {"id": "premortem", "regex": "\\b(pre-?mortem|what could go wrong|failure modes?|assume (this|it) fail(s|ed)?|why (did|would) (this|it) fail)\\b", "domain": "premortem", "skill": null},
      {"id": "acceptance", "regex": "\\b(acceptance criteria|user stor(y|ies)|given[ /]when[ /]then|(into|to) github issues)\\b", "domain": "acceptance", "skill": "prd-to-issues"},
      {"id": "incident", "regex": "\\b(incident (response|report|review)|prod(uction)? incident|outage|sev ?[0-3]|(prod|production|site|server|app)(\\'?s| is)? (down|degraded))\\b", "domain": "incident", "skill": "incident-response", "crew": "incident-response"},
      {"id": "security-audit", "regex": "\\b(secu(ri|ir)ty (audit|review)|pen-?test(ing)?|penetration test(ing)?)\\b", "domain": "security", "skill": "sentry-security-review", "crew": "security-audit"},
      {"id": "threat-model", "regex": "\\bthreat[- ]?model(s|ing)?\\b", "domain": "security", "skill": "threat-modeling"},
      {"id": "exploit", "regex": "\\b(exploit(s|able)?|proof[- ]of[- ]concept attack)\\b", "domain": "pentest", "skill": "sentry-security-review"},
      {"id": "security", "regex": "\\b(secu(ri|ir)ty(?! deposit)|vulnerab(le|ility|ilities)|xss|csrf|ssrf|sql injection|authz|secrets? leak|leak(ing|ed|s)? (secrets?|keys?|credentials|tokens?))\\b", "domain": "security", "skill": "sentry-security-review"},
      {"id": "arch-review", "regex": "\\b(architecture review|design review)\\b", "domain": "architecture", "skill": "hld", "crew": "architecture-review"},
      {"id": "tech-choice", "regex": "\\b(build (vs\\.?|or) buy|tech(nology)? stack|which (framework|database|library)|should we (use|adopt|pick))\\b", "domain": "decision", "skill": "decision-journal", "crew": "sabha"},
      {"id": "fix-issue", "regex": "\\bfix(es)?\\s+(issue\\s+)?#\\d+\\b", "domain": "backend", "skill": "systematic-debugging"},
      {"id": "debug", "regex": "\\b(bugs?|d[eu]bug(ging)?|stack ?trace|traceback|\\w+Error|exceptions?|crash(es|ing)?(?! course)|regression|flaky|returns? (null|undefined|500|an error)|returning (null|undefined|500|an error)|keeps? (failing|stalling)|not working)\\b", "domain": "backend", "skill": "systematic-debugging"},
      {"id": "ci-cd", "regex": "\\b(ci/?cd|ci|(the|our|my|this|ci|build|data) pipeline|pipeline (failed|failing|is red)|github actions?|terraform|kubernetes|k8s|dockerfile|deploy(ing|s)? (to|the|this|my|our|it)\\b|deployment (pipeline|script|config|failed|to))\\b", "domain": "devops", "skill": "ci-cd"},
      {"id": "observability", "regex": "\\b(observability|monitoring|slos?|alert(s|ing)|structured logging|tracing|prometheus|grafana|opentelemetry|otel)\\b", "domain": "devops", "skill": "observability"},
      {"id": "release", "regex": "\\b(release (notes|checklist|plan)|changelog|go/no-go)\\b", "domain": "program", "skill": "release-engineering"},
      {"id": "experiment", "regex": "\\b(a/?b tests?|experiment results?|statistical(ly)? significan(t|ce)|metrics analysis)\\b", "domain": "data", "skill": "data-analysis"},
      {"id": "prd", "regex": "\\b(prd|product requirements|product spec|roadmap|success metrics)\\b", "domain": "product", "skill": "product-spec"},
      {"id": "testing", "regex": "\\b(unit tests?|integration tests?|e2e tests?|regression tests?|test cases?|test coverage|write tests|add tests)\\b", "domain": "testing", "skill": "testing"},
      {"id": "lean-code", "regex": "\\b(over-?engineer\\w*|over-?complicat\\w*|yagni|simplest (solution|fix|way)|smallest (change|fix|diff))\\b", "domain": "code", "skill": "ponytail"},
      {"id": "code-review", "regex": "\\b(review (my |the |this )?(code|diff|pr|pull request|changes|function)|look over this|anything wrong)\\b", "domain": "code", "skill": "code-review"},
      {"id": "refactor", "regex": "\\b(refact[oe]r(ing)?|simplify|clean ?up|dedupe|duplication)\\b", "domain": "code", "skill": "sentry-code-simplifier"},
      {"id": "architecture", "regex": "\\b(architecture|system design|hld|lld|adr)\\b", "domain": "architecture", "skill": "hld"},
      {"id": "design-md-lint", "regex": "\\bdesign\\.md\\b", "domain": "frontend", "skill": "impeccable", "tool": "design-md-lint"},
      {"id": "threejs", "regex": "\\b(three\\.?js|webgl|react three fiber|r3f)\\b", "domain": "frontend", "skill": "threejs-fundamentals"},
      {"id": "shaders", "regex": "\\b(glsl|fragment shaders?|vertex shaders?)\\b", "domain": "frontend", "skill": "threejs-shaders"},
      {"id": "gesture-physics", "regex": "\\b((swipe|drag|pinch|touch) gestures?|gesture (physics|handling|recogni[sz]er)|(bottom )?sheet physics|bottom sheets?|rubber-?band(ing)?|momentum scroll(ing)?|spring physics|drag physics|swipe)\\b", "domain": "frontend", "skill": "apple-design"},
      {"id": "scroll-motion", "regex": "\\b(scroll-?trigger|scroll-?(led|driven|telling)|scrollytelling|parallax)\\b", "domain": "frontend", "skill": "gsap-scrolltrigger"},
      {"id": "gsap", "regex": "\\bgsap\\b", "domain": "frontend", "skill": "gsap-core"},
      {"id": "chart-video", "regex": "\\b(chart|data)[- ](animation|motion|video|short)s?\\b|\\banimat\\w+ (a |the |my )?(charts?|graphs?)\\b|\\bdata viz video\\b", "domain": null, "skill": "remotion-video", "tool": "video-shotcraft"},
      {"id": "motion", "regex": "\\b(animat\\w*|motion (design|craft|audit)|micro-?interactions?|easing)\\b", "domain": "frontend", "skill": "design-motion-principles"},
      {"id": "palette-lookup", "regex": "\\b((?<!paint )colou?r palettes?|palettes? for|(font|type|typeface) pairings?|chart types?|product[- ]type patterns?)\\b", "domain": "frontend", "skill": "ui-ux-pro-max"},
      {"id": "shadcn", "regex": "\\bshad ?cn\\b", "domain": "frontend", "skill": null, "tool": "shadcn-mcp"},
      {"id": "devtools-perf", "regex": "\\b(lighthouse|heap snapshots?|performance traces?|core web vitals)\\b", "domain": "frontend", "skill": null, "tool": "chrome-devtools-mcp"},
      {"id": "design-critique", "regex": "\\b(design direction|visual direction|look and feel|redesign|design critique|ux (review|audit|critique)|critique (the|this|my) (design|ui|ux|page)|polish (the|this|my) (design|ui|ux|page)|looks? (generic|bland|ai[- ]generated)|deslop)\\b", "domain": "frontend", "skill": "impeccable"},
      {"id": "new-site", "regex": "\\b(new (website|homepage|landing page|site)|portfolio site|marketing site)\\b", "domain": "frontend", "skill": "hallmark"},
      {"id": "math-video", "regex": "\\b(manim|worked[- ]math|maths? (explainer|scene|animation|video)s?|latex)\\b", "domain": null, "skill": "manim-video"},
      {"id": "remotion", "regex": "\\bremotion\\b", "domain": null, "skill": "remotion-video"},
      {"id": "yt-viral", "regex": "\\b(viral (hooks?|videos?|outliers?)|outlier videos?|overperform\\w*|hook research)\\b", "domain": null, "skill": "yt-viral"},
      {"id": "youtube", "regex": "\\b(youtube|yt) (shorts?|seo|metadata|retention|channel|audit|analytics|titles?|thumbnails?)\\b|\\b(shorts?|video) (strategy|hooks?|metadata|titles?)\\b|\\bthumbnails? and titles\\b|\\bhook for my (next )?(short|video)\\b", "domain": null, "skill": "claude-youtube"},
      {"id": "instagram", "regex": "\\b(instagram (reels?|hooks?|captions?|posts?|carousels?)|ig (reels?|captions?|hooks?)|reel hooks?)\\b", "domain": null, "skill": "ig-reel"},
      {"id": "sfx", "regex": "\\b(sound effects?|sfx|sound design|whoosh(es)?)\\b", "domain": null, "skill": null, "tool": "earshot"},
      {"id": "narration", "regex": "\\b(text[- ]to[- ]speech|tts|voice-?over|narration)\\b", "domain": null, "skill": null, "tool": "kokoro"},
      {"id": "motion-graphics", "regex": "\\bhyperframes\\b", "domain": null, "skill": null, "tool": "hyperframes"},
      {"id": "video-edit", "regex": "\\b(edit|cut|make|create|render|build|review) (a |an |the |this |my |our )?(\\w+ )?(videos?|reels?|youtube shorts?)\\b(?! (players?|elements?|tags?|components?|calls?|conferenc\\w*))", "domain": null, "skill": "video-editor"},
      {"id": "ffmpeg", "regex": "\\b(ffmpeg|mp4|trim (this|the) (clip|video)|burn in( the)? captions)\\b", "domain": null, "skill": null, "tool": "ffmpeg-skill"},
      {"id": "topic-research", "regex": "\\b(last 30 days|last30days|what(\\'?s| is) the latest on|what (are )?(people|devs|users) (are )?(saying|think)|community sentiment|recent discussions?)\\b", "domain": null, "skill": "last30days"},
      {"id": "social-scrape", "regex": "\\b(bulk social data|scrapecreators|tiktok data|scrape (tiktok|instagram|youtube|x))\\b", "domain": null, "skill": null, "tool": "scrapecreators"},
      {"id": "look-at-page", "regex": "\\b(localhost(:\\d+)?|the running (app|page|site)|check (it|the page|the site) renders?)\\b", "domain": "frontend", "skill": null, "tool": "playwright-mcp"},
      {"id": "brandmd", "regex": "\\b(brandmd|design tokens from (my|our|this) (site|website|url))\\b", "domain": "frontend", "skill": null, "tool": "brandmd"},
      {"id": "design-dna", "regex": "\\bdesign tokens\\b", "domain": "frontend", "skill": null, "tool": "design-dna"},
      {"id": "app-store", "regex": "\\b(app store|play store) (screenshots?|images?|listing)\\b", "domain": "frontend", "skill": null, "tool": "app-store-screenshots"},
      {"id": "talking-head", "regex": "\\btalking[- ]head\\b", "domain": null, "skill": null, "tool": "ghost-editor"},
      {"id": "connector", "regex": "\\b(mcp server|custom connector)\\b", "domain": null, "skill": null, "tool": "mcp-builder"},
      {"id": "api", "regex": "\\b(api|endpoints?|rest api|graphql|openapi)\\b", "domain": "backend", "skill": "api-design"},
      {"id": "database", "regex": "\\b(database|schema|migrations?|postgres(ql)?|mysql|sqlite|sql|dynamodb|mongodb|queries)\\b", "domain": "backend", "skill": "database-design"},
      {"id": "performance", "regex": "\\b((improve|optimi[sz]e|fix|slow|web|page|site|app|query)( \\w+)? performance|performance (issues?|problems?|bottlenecks?|regressions?|budgets?|tuning)|latency|p99|profil(e|ing)|too slow|so slow|n\\+1|bundle size)\\b", "domain": "backend", "skill": "performance-profiler"},
      {"id": "accessibility", "regex": "\\b(accessi\\w*ity|a11y|wcag|keyboard nav\\w*|screen readers?|contrast ratio|aria labels?)\\b", "domain": "frontend", "skill": "audit"},
      {"id": "frontend", "regex": "\\b(ui|ux|frontend|front-end|components?|css|html|tailwind|react|vue|svelte|next\\.?js|website|web ?app|dashboard|homepage|landing page|web page|buttons?|navbar|sidebar|modal|dropdown|responsive|misaligned|look and feel|horizontal overflow|layout shift|reduced[- ]motion|(login|signup|settings|pricing|checkout) (page|form|screen))\\b", "domain": "frontend", "skill": "frontend-designer"},
      {"id": "full-stack", "regex": "\\b(full[- ]?stack|end[- ]to[- ]end(?! tests?))\\b", "domain": "architecture", "skill": null, "crew": "feature-build"},
      {"id": "spike", "regex": "\\b(spike|prototype|quick trial)\\b", "domain": "junior", "skill": null}
    ]
  },
  "security": {
    "comment": "Read by engine/sanitizer.ts, a reference implementation tested in CI that nothing calls at runtime. At runtime, wrapping untrusted content in <untrusted-data> is an instruction the model follows (SKILL.md); stripping patterns is best effort.",
    "sanitization": {
      "stripPatterns": [
        "ignore previous instructions",
        "ignore all previous",
        "disregard all prior",
        "you are now",
        "from now on you",
        "system prompt",
        "IMPORTANT:",
        "\\[INST\\]",
        "\\[/INST\\]",
        "<\\|im_start\\|>",
        "<\\|im_end\\|>",
        "<\\|endoftext\\|>",
        "<system>",
        "</system>",
        "\\[SYSTEM\\]",
        "<instructions>",
        "</instructions>",
        "Human:",
        "Assistant:",
        "###\\s*(System|User|Assistant)",
        "\\bBEGIN INJECTION\\b",
        "\\bEND INJECTION\\b"
      ],
      "maxContentLength": 50000,
      "escapeControlChars": true,
      "wrapInTags": true,
      "tagName": "untrusted-data"
    }
  },
  "cortex": {
    "comment": "Domain -> agent. Agents run through the Agent tool (subagent_type) or a workflow agentType, so each agent's own tools, model and effort apply. krishna is never a routing target.",
    "agentsDir": "~/.claude/agents",
    "deliverWorkflow": "vajra-deliver",
    "agentRouting": {
      "backend":      { "agent": "bhima",          "skills": ["api-design", "database-design", "performance-profiler", "systematic-debugging"] },
      "frontend":     { "agent": "nakula",         "skills": ["frontend-designer", "frontend-design", "ui-styling", "react-best-practices", "audit"] },
      "security":     { "agent": "bhishma",        "skills": ["threat-modeling", "sentry-security-review", "sentry-find-bugs"] },
      "pentest":      { "agent": "shakuni",        "skills": ["sentry-security-review"] },
      "premortem":    { "agent": "duryodhana",     "skills": ["decision-journal"] },
      "testing":      { "agent": "vidura",         "skills": ["testing", "property-based-testing", "webapp-testing"] },
      "acceptance":   { "agent": "drona",          "skills": ["prd-to-issues", "product-spec"] },
      "devops":       { "agent": "hanuman",        "skills": ["ci-cd", "observability"] },
      "incident":     { "agent": "ashwatthama",    "skills": ["incident-response", "systematic-debugging"] },
      "product":      { "agent": "draupadi",       "skills": ["product-spec", "brainstorming", "research"] },
      "architecture": { "agent": "arjuna",         "skills": ["hld", "lld", "architecture-diagrams"] },
      "code":         { "agent": "arjuna",         "skills": ["code-review", "sentry-code-simplifier", "improve-codebase-architecture"] },
      "decision":     { "agent": "yudhishthira",   "skills": ["decision-journal", "research"] },
      "data":         { "agent": "sahadeva",       "skills": ["data-analysis"] },
      "quant":        { "agent": "karna",          "skills": ["backtest-validation", "data-analysis"] },
      "junior":       { "agent": "abhimanyu",      "skills": ["docs-validator"] },
      "program":      { "agent": "dhrishtadyumna", "skills": ["release-engineering", "writing-plans", "prd-to-issues"] }
    },
    "fleetCrews": {
      "feature-build":       { "workflow": "vajra-feature-build",       "lead": "arjuna",       "agents": ["bhima", "nakula", "vidura"],                       "description": "Feature build: design, backend and frontend writers in worktrees, independent verification and review" },
      "security-audit":      { "workflow": "vajra-security-audit",      "lead": "bhishma",      "agents": ["shakuni", "duryodhana", "vidura"],                 "description": "Security audit: threat model, exploit PoCs as failing tests, verification" },
      "incident-response":   { "workflow": "vajra-incident-response",   "lead": "ashwatthama",  "agents": ["hanuman", "bhima", "vidura"],                     "description": "Incident: triage, a reversible mitigation plan for approval, root-cause fix" },
      "architecture-review": { "workflow": "vajra-architecture-review", "lead": "yudhishthira", "agents": ["arjuna", "bhishma", "draupadi"],                  "description": "Architecture review: design, security and product perspectives, then a verdict" },
      "sabha":               { "workflow": "vajra-sabha",               "lead": "yudhishthira", "agents": ["arjuna", "bhishma", "draupadi", "duryodhana"],    "description": "Debate: positions, adversary pre-mortem, a vote counted in code, synthesis" }
    }
  }
}
