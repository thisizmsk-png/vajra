{
  "description": "Vajra hooks. scripts/install.sh merges this block into ~/.claude/settings.json (backed up, idempotent); --unregister-hooks removes it. Entries are recognized by the command path /.claude/skills/vajra/hooks/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|LS|mcp__vajra-desktop__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/pre-tool-use.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/desktop-control.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/post-tool-use.sh\"",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/desktop-control.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/post-tool-use.sh\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/session-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/pre-compact.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/vajra/hooks/user-prompt-submit.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
