        { "kind": "npm", "package": "@google/gemini-cli", "version": "0.68.0", "integrity": "sha512-eq7AWY+YCijNGKVwyiRjN+GuOdXU/djuOZhX18p+HDmNyUqFdqH7C5V6vDJLl1uffhRPhGijePV+YvY8lymrbQ==", "command": "npm install -g @google/gemini-cli" }
      ]
