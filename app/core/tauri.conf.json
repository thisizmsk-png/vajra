{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vajra Desktop",
  "version": "0.1.0",
  "identifier": "dev.vajra.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/app/ui\" && npm ci --no-audit --no-fund && npm run build'",
    "beforeDevCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/app/ui\" && npm run dev'",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vajra Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
