{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vajra Desktop",
  "version": "0.1.0",
  "identifier": "dev.vajra.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/app/ui\" && npm ci --no-audit --no-fund && npm run build'",
    "beforeDevCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)/app/ui\" && npm run dev'",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vajra Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "gen/engine/engine.tgz": "engine/engine.tgz"
    }
  }
}
