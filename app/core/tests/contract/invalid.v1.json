{
  "note": "Each case patches the base fixture (project.v1.json or session.v1.json): `set` replaces top-level fields, `unset` removes them. Both the core (tests/contract.rs) and the UI (tests/projectContract.test.ts) must reject every case with the named reason: malformed (not usable as this shape), invalid (a rule is broken) or unsupported_version.",
  "project": [
    {"case": "no schema",                   "unset": ["schema"],                          "reason": "malformed"},
    {"case": "schema with a newline",       "set": {"schema": "vajra.project/1\n"},      "reason": "unsupported_version"},
    {"case": "schema of another thing",     "set": {"schema": "vajra.session/1"},         "reason": "unsupported_version"},
    {"case": "id with a trailing newline",  "set": {"id": "p_01JC5X8Z3A9K2M4N6P7Q8R9S0T\n"}, "reason": "invalid"},
    {"case": "id of a session",             "set": {"id": "s_01JC5X8Z3A9K2M4N6P7Q8R9S0T"}, "reason": "invalid"},
    {"case": "id not a string",             "set": {"id": 5},                            "reason": "malformed"},
    {"case": "name missing",                "unset": ["name"],                            "reason": "malformed"},
    {"case": "name not a string",           "set": {"name": 5},                           "reason": "malformed"},
    {"case": "name empty",                  "set": {"name": ""},                          "reason": "invalid"},
    {"case": "name blank",                  "set": {"name": "   "},                       "reason": "invalid"},
    {"case": "name with a newline",         "set": {"name": "a\nb"},                      "reason": "invalid"},
    {"case": "name with a zero-width char", "set": {"name": "ab​cd"},               "reason": "invalid"},
    {"case": "name with a bidi override",   "set": {"name": "ab‮cd"},               "reason": "invalid"},
    {"case": "root relative",               "set": {"root": "relative/dir"},             "reason": "invalid"},
    {"case": "root with ..",                "set": {"root": "/a/../b"},                  "reason": "invalid"},
    {"case": "root with .",                 "set": {"root": "/a/./b"},                   "reason": "invalid"},
    {"case": "root with //",                "set": {"root": "/a//b"},                    "reason": "invalid"},
    {"case": "root with a trailing slash",  "set": {"root": "/a/b/"},                    "reason": "invalid"},
    {"case": "root with NUL",               "set": {"root": "/a\u0000b"},                "reason": "invalid"},
    {"case": "root not a string",           "set": {"root": 5},                           "reason": "malformed"},
    {"case": "git common dir with ..",      "set": {"root_key": {"dev": "1", "ino": "2", "git_common_dir": "../.git"}}, "reason": "invalid"},
    {"case": "git common dir not a string", "set": {"root_key": {"dev": "1", "ino": "2", "git_common_dir": 5}}, "reason": "malformed"},
    {"case": "root_key missing",            "unset": ["root_key"],                        "reason": "malformed"},
    {"case": "dev not a string",            "set": {"root_key": {"dev": 5, "ino": "2"}},   "reason": "malformed"},
    {"case": "dev not digits",              "set": {"root_key": {"dev": "x", "ino": "2"}}, "reason": "malformed"},
    {"case": "ino negative",                "set": {"root_key": {"dev": "1", "ino": "-2"}}, "reason": "malformed"},
    {"case": "ino with a plus sign",        "set": {"root_key": {"dev": "1", "ino": "+2"}}, "reason": "malformed"},
    {"case": "ino with a leading zero",     "set": {"root_key": {"dev": "1", "ino": "02"}}, "reason": "malformed"},
    {"case": "ino empty",                   "set": {"root_key": {"dev": "1", "ino": ""}},   "reason": "malformed"},
    {"case": "ino fractional",              "set": {"root_key": {"dev": "1", "ino": "1.5"}}, "reason": "malformed"},
    {"case": "ino with a trailing newline", "set": {"root_key": {"dev": "1", "ino": "2\n"}}, "reason": "malformed"},
    {"case": "dev beyond u64",              "set": {"root_key": {"dev": "18446744073709551616", "ino": "2"}}, "reason": "malformed"},
    {"case": "created not a time",          "set": {"created": "yesterday"},              "reason": "invalid"},
    {"case": "created with a plus sign",    "set": {"created": "+026-11-08T09:00:00Z"},   "reason": "invalid"},
    {"case": "created with a newline",      "set": {"created": "2026-11-08T09:00:00Z\n"}, "reason": "invalid"},
    {"case": "created missing",             "unset": ["created"],                         "reason": "malformed"},
    {"case": "archived not a time",         "set": {"archived": "2026-13-40T00:00:00Z"}, "reason": "invalid"},
    {"case": "archived not a string",       "set": {"archived": 5},                       "reason": "malformed"},
    {"case": "rev zero",                    "set": {"rev": 0},                            "reason": "invalid"},
    {"case": "rev negative",                "set": {"rev": -1},                           "reason": "malformed"},
    {"case": "rev fractional",              "set": {"rev": 1.5},                          "reason": "malformed"},
    {"case": "rev a string",                "set": {"rev": "7"},                          "reason": "malformed"},
    {"case": "rev beyond 2^53-1",           "set": {"rev": 9007199254740992},         "reason": "invalid"},
    {"case": "rev missing",                 "unset": ["rev"],                             "reason": "malformed"}
  ],
  "session": [
    {"case": "no schema",                   "unset": ["schema"],                          "reason": "malformed"},
    {"case": "schema of another major",     "set": {"schema": "vajra.session/2"},         "reason": "unsupported_version"},
    {"case": "id with a trailing newline",  "set": {"id": "s_01JC5X8Z3B0K2M4N6P7Q8R9S0T\n"}, "reason": "invalid"},
    {"case": "id of a project",             "set": {"id": "p_01JC5X8Z3B0K2M4N6P7Q8R9S0T"}, "reason": "invalid"},
    {"case": "project_id of a session",     "set": {"project_id": "s_01JC5X8Z3A9K2M4N6P7Q8R9S0T"}, "reason": "invalid"},
    {"case": "project_id missing",          "unset": ["project_id"],                      "reason": "malformed"},
    {"case": "kind missing",                "unset": ["kind"],                            "reason": "malformed"},
    {"case": "kind not a string",           "set": {"kind": 5},                           "reason": "malformed"},
    {"case": "status missing",              "unset": ["status"],                          "reason": "malformed"},
    {"case": "status null",                 "set": {"status": null},                      "reason": "malformed"},
    {"case": "orchestrator with a parent",  "set": {"kind": "orchestrator"},              "reason": "invalid"},
    {"case": "parent is itself",            "set": {"parent": "s_01JC5X8Z3B0K2M4N6P7Q8R9S0T"}, "reason": "invalid"},
    {"case": "parent not an id",            "set": {"parent": "x"},                        "reason": "invalid"},
    {"case": "parent not a string",         "set": {"parent": 5},                          "reason": "malformed"},
    {"case": "provider empty",              "set": {"provider": ""},                        "reason": "invalid"},
    {"case": "provider with a space",       "set": {"provider": "NOT OK"},                 "reason": "invalid"},
    {"case": "provider uppercase",          "set": {"provider": "Claude"},                 "reason": "invalid"},
    {"case": "provider missing",            "unset": ["provider"],                        "reason": "malformed"},
    {"case": "native id an option",         "set": {"native_session_id": "--last"},       "reason": "invalid"},
    {"case": "native id not a string",      "set": {"native_session_id": 5},              "reason": "malformed"},
    {"case": "run id malformed",            "set": {"run_id": "x"},                        "reason": "invalid"},
    {"case": "run id not a string",         "set": {"run_id": 5},                          "reason": "malformed"},
    {"case": "campaign with a slash",       "set": {"campaign": "a/b"},                   "reason": "invalid"},
    {"case": "campaign starting with a dot", "set": {"campaign": ".hidden"},              "reason": "invalid"},
    {"case": "task id empty",               "set": {"task_id": ""},                        "reason": "invalid"},
    {"case": "attempt a string",            "set": {"attempt": "x"},                       "reason": "malformed"},
    {"case": "attempt negative",            "set": {"attempt": -1},                        "reason": "malformed"},
    {"case": "attempt fractional",          "set": {"attempt": 1.5},                       "reason": "malformed"},
    {"case": "generation negative",         "set": {"generation": -1},                     "reason": "malformed"},
    {"case": "generation fractional",       "set": {"generation": 1.5},                    "reason": "malformed"},
    {"case": "generation over u32",         "set": {"generation": 4294967296},             "reason": "malformed"},
    {"case": "generation missing",          "unset": ["generation"],                      "reason": "malformed"},
    {"case": "started not a time",          "set": {"started": "now"},                     "reason": "invalid"},
    {"case": "started missing",             "unset": ["started"],                         "reason": "malformed"},
    {"case": "ended not a time",            "set": {"ended": "x"},                         "reason": "invalid"},
    {"case": "ended not a string",          "set": {"ended": 5},                           "reason": "malformed"}
  ]
}
