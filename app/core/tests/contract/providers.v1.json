{
  "schema": "vajra.providers/1",
  "providers": [
    {
      "id": "claude",
      "name": "Claude Code",
      "installed": true,
      "path": "/Users/u/.local/bin/claude",
      "version": "2.1.0",
      "tested": "tested",
      "tested_range": "2.0 to 2.1",
      "capabilities": {
        "pty_attach": true,
        "transcript": true,
        "inspect": true,
        "message": true,
        "redirect": true,
        "stop": "hook_block",
        "resume": true,
        "vajra_workflow": true
      },
      "limits": [],
      "login": {
        "route": "Uses your Claude Code login",
        "state": "signed_in",
        "checked_by": "cli_status",
        "detail": null,
        "route_code": "uses_claude_login"
      },
      "billing": {
        "source": "login",
        "key_in_app_env": null
      }
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "installed": true,
      "path": "/opt/homebrew/bin/codex",
      "version": "0.9.0",
      "tested": "untested",
      "tested_range": "0.7 to 0.8",
      "capabilities": {
        "pty_attach": true,
        "transcript": false,
        "inspect": false,
        "message": false,
        "redirect": false,
        "stop": "terminate",
        "resume": true,
        "vajra_workflow": false
      },
      "limits": [
        {
          "control": "message",
          "reason": "Codex cannot take a message mid-run",
          "code": "no_message_mid_run"
        },
        {
          "control": "redirect",
          "reason": "Codex cannot be redirected mid-run",
          "code": "no_redirect_mid_run"
        },
        {
          "control": "vajra_workflow",
          "reason": "Codex does not run the Vajra workflow",
          "code": "no_vajra_workflow"
        },
        {
          "control": "stop",
          "code": "stop_ends_process",
          "reason": "Codex has no hand-off: Stop ends its process"
        }
      ],
      "login": {
        "route": "Uses your Codex login",
        "state": "cannot_tell",
        "checked_by": "none",
        "detail": "This CLI has no read-only login status command",
        "route_code": "uses_codex_login",
        "detail_code": "check_not_understood"
      },
      "billing": {
        "source": "login",
        "key_in_app_env": "OPENAI_API_KEY"
      }
    }
  ]
}
