{
  "_": "Shared cases for the plan rules (ADR-16 16.5). 'expect' is what workflows/vajra-deliver.js gives; the node test tests/workflows/vajra-plan-parity.test.mjs and the Rust test desktop::plan::tests both check it. Regenerate with that node test and --write. A task may omit title ('title'), brief ('brief'), owner_role ('backend'), deps and criteria ([]).",
  "defaults": {
    "seats": [
      "backend",
      "frontend",
      "tests"
    ],
    "criteria": [
      {
        "id": "ac-1",
        "criterion": "export has --json",
        "check": "npm test -- export"
      },
      {
        "id": "ac-2",
        "criterion": "docs mention it",
        "check": "grep -q json README.md"
      }
    ],
    "max_in_flight": 2
  },
  "js_rules_sha256": "3dc196e676a38c26a225c2a98bb704e4cab5156202273a0b90dbe416646490e7",
  "cases": [
    {"name":"criteria: one is enough","kind":"criteria","criteria":[{"id":"ac-1","criterion":"a","check":"true"}],"expect":{"error":null}},
    {"name":"criteria: none","kind":"criteria","criteria":[],"expect":{"error":"acceptance_criteria must have 1-12 entries"}},
    {"name":"criteria: thirteen","kind":"criteria","criteria":[{"id":"ac-1","criterion":"a","check":"c"},{"id":"ac-2","criterion":"a","check":"c"},{"id":"ac-3","criterion":"a","check":"c"},{"id":"ac-4","criterion":"a","check":"c"},{"id":"ac-5","criterion":"a","check":"c"},{"id":"ac-6","criterion":"a","check":"c"},{"id":"ac-7","criterion":"a","check":"c"},{"id":"ac-8","criterion":"a","check":"c"},{"id":"ac-9","criterion":"a","check":"c"},{"id":"ac-10","criterion":"a","check":"c"},{"id":"ac-11","criterion":"a","check":"c"},{"id":"ac-12","criterion":"a","check":"c"},{"id":"ac-13","criterion":"a","check":"c"}],"expect":{"error":"acceptance_criteria must have 1-12 entries"}},
    {"name":"criteria: id shape","kind":"criteria","criteria":[{"id":"AC-1","criterion":"a","check":"c"}],"expect":{"error":"criterion id \"AC-1\" must look like ac-1"}},
    {"name":"criteria: three digits","kind":"criteria","criteria":[{"id":"ac-100","criterion":"a","check":"c"}],"expect":{"error":"criterion id \"ac-100\" must look like ac-1"}},
    {"name":"criteria: duplicate","kind":"criteria","criteria":[{"id":"ac-1","criterion":"a","check":"c"},{"id":"ac-1","criterion":"b","check":"c"}],"expect":{"error":"duplicate criterion id ac-1"}},
    {"name":"criteria: blank check","kind":"criteria","criteria":[{"id":"ac-1","criterion":"a","check":"  "}],"expect":{"error":"criterion ac-1 needs text and a check"}},
    {"name":"criteria: blank text","kind":"criteria","criteria":[{"id":"ac-2","criterion":"","check":"c"}],"expect":{"error":"criterion ac-2 needs text and a check"}},
    {"name":"criteria: a long id is cut in the message","kind":"criteria","criteria":[{"id":"ac-1 and then a very long tail that goes on and on and on","criterion":"a","check":"c"}],"expect":{"error":"criterion id \"ac-1 and then a very long tail that goes\" must look like ac-1"}},
    {"name":"plan: three tasks with deps","kind":"plan","tasks":[{"id":"t1","owner_role":"backend","files":["src/export/"],"criteria":["ac-1"]},{"id":"t2","owner_role":"frontend","files":["README.md"],"criteria":["ac-2"],"deps":["t1"]},{"id":"t3","owner_role":"tests","files":["test/export.test.ts"],"deps":["t1"]}],"expect":{"error":null,"order":["t1","t2","t3"],"waves":[["t1"],["t2","t3"]]}},
    {"name":"plan: no tasks","kind":"plan","tasks":[],"expect":{"error":"plan must have 1-8 tasks"}},
    {"name":"plan: nine tasks","kind":"plan","tasks":[{"id":"t1","files":["a1"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["a2"]},{"id":"t3","files":["a3"]},{"id":"t4","files":["a4"]},{"id":"t5","files":["a5"]},{"id":"t6","files":["a6"]},{"id":"t7","files":["a7"]},{"id":"t8","files":["a8"]},{"id":"t9","files":["a9"]}],"expect":{"error":"plan must have 1-8 tasks"}},
    {"name":"plan: eight tasks","kind":"plan","tasks":[{"id":"t1","files":["a1"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["a2"],"deps":["t1"]},{"id":"t3","files":["a3"]},{"id":"t4","files":["a4"],"deps":["t2","t3"]},{"id":"t5","files":["a5"]},{"id":"t6","files":["a6"]},{"id":"t7","files":["a7"]},{"id":"t8","files":["a8"],"deps":["t7"]}],"expect":{"error":null,"order":["t1","t2","t3","t4","t5","t6","t7","t8"],"waves":[["t1","t3"],["t5","t6"],["t7"],["t2","t8"],["t4"]]}},
    {"name":"plan: task id shape","kind":"plan","tasks":[{"id":"task1","files":["a"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task id \"task1\" must look like t1"}},
    {"name":"plan: task id three digits","kind":"plan","tasks":[{"id":"t100","files":["a"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task id \"t100\" must look like t1"}},
    {"name":"plan: duplicate task id","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1","ac-2"]},{"id":"t1","files":["b"]}],"expect":{"error":"duplicate task id t1"}},
    {"name":"plan: role with no seat","kind":"plan","tasks":[{"id":"t1","owner_role":"docs","files":["a"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: owner must be one of backend, frontend, tests"}},
    {"name":"plan: a checker role is no writer seat","kind":"plan","seats":["backend","verifier"],"tasks":[{"id":"t1","owner_role":"verifier","files":["a"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: owner must be one of backend"}},
    {"name":"plan: blank title","kind":"plan","tasks":[{"id":"t1","title":" ","files":["a"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1 needs a title and a brief"}},
    {"name":"plan: blank brief","kind":"plan","tasks":[{"id":"t1","brief":"","files":["a"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1 needs a title and a brief"}},
    {"name":"plan: no files","kind":"plan","tasks":[{"id":"t1","files":[],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1 must own at least one path"}},
    {"name":"plan: absolute path","kind":"plan","tasks":[{"id":"t1","files":["/etc/passwd"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: unsafe path \"/etc/passwd\""}},
    {"name":"plan: home path","kind":"plan","tasks":[{"id":"t1","files":["~/x"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: unsafe path \"~/x\""}},
    {"name":"plan: dot-dot path","kind":"plan","tasks":[{"id":"t1","files":["src/../../x"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: unsafe path \"src/../../x\""}},
    {"name":"plan: a space in a path","kind":"plan","tasks":[{"id":"t1","files":["src/a b.ts"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: unsafe path \"src/a b.ts\""}},
    {"name":"plan: a question mark is no SAFE_PATH glob","kind":"plan","tasks":[{"id":"t1","files":["src/?.ts"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: unsafe path \"src/?.ts\""}},
    {"name":"plan: a newline in a path is shown on one line","kind":"plan","tasks":[{"id":"t1","files":["src/a\nb"],"criteria":["ac-1","ac-2"]}],"expect":{"error":"task t1: unsafe path \"src/a b\""}},
    {"name":"plan: globs and odd but safe paths","kind":"plan","tasks":[{"id":"t1","files":["src/**","./pkg/@scope/x+y.ts"],"criteria":["ac-1"]},{"id":"t2","files":["docs/*.md","lib/x"],"criteria":["ac-2"]},{"id":"t3","files":["lib/xy"]}],"expect":{"error":null,"order":["t1","t2","t3"],"waves":[["t1","t2"],["t3"]]}},
    {"name":"plan: unknown criterion","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1","ac-2","ac-9"]}],"expect":{"error":"task t1: unknown criterion ac-9"}},
    {"name":"plan: a criterion nobody covers","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1"]}],"expect":{"error":"criterion ac-2 is not covered by any task"}},
    {"name":"plan: unknown dependency","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1","ac-2"],"deps":["t7"]}],"expect":{"error":"task t1: bad dependency t7"}},
    {"name":"plan: self dependency","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1","ac-2"],"deps":["t1"]}],"expect":{"error":"task t1: bad dependency t1"}},
    {"name":"plan: a directory and a file in it","kind":"plan","tasks":[{"id":"t1","files":["src/"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["x","src/a.ts"]}],"expect":{"error":"tasks t1 and t2 both own src/; files must be disjoint"}},
    {"name":"plan: a glob and a file it matches","kind":"plan","tasks":[{"id":"t1","files":["src/*.ts"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["src/a.ts"]}],"expect":{"error":"tasks t1 and t2 both own src/*.ts; files must be disjoint"}},
    {"name":"plan: the repo root overlaps everything","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["."]}],"expect":{"error":"tasks t1 and t2 both own a; files must be disjoint"}},
    {"name":"plan: a trailing double star is the directory","kind":"plan","tasks":[{"id":"t1","files":["docs/**"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["docs"]}],"expect":{"error":"tasks t1 and t2 both own docs/**; files must be disjoint"}},
    {"name":"plan: files disjoint across all tasks, not only neighbours","kind":"plan","tasks":[{"id":"t1","files":["a/x"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["b"]},{"id":"t3","files":["c"],"deps":["t1"]},{"id":"t4","files":["a/"]}],"expect":{"error":"tasks t1 and t4 both own a/x; files must be disjoint"}},
    {"name":"plan: a cycle","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1","ac-2"],"deps":["t3"]},{"id":"t2","files":["b"],"deps":["t1"]},{"id":"t3","files":["c"],"deps":["t2"]}],"expect":{"error":"task dependencies contain a cycle"}},
    {"name":"plan: two-task cycle after a good chain","kind":"plan","tasks":[{"id":"t1","files":["a"],"criteria":["ac-1","ac-2"]},{"id":"t2","files":["b"],"deps":["t1","t3"]},{"id":"t3","files":["c"],"deps":["t2"]}],"expect":{"error":"task dependencies contain a cycle"}},
    {"name":"plan: deps listed out of order","kind":"plan","max_in_flight":1,"tasks":[{"id":"t3","files":["c"],"deps":["t2"],"criteria":["ac-2"]},{"id":"t1","files":["a"],"criteria":["ac-1"]},{"id":"t2","files":["b"],"deps":["t1"]},{"id":"t4","files":["d"]}],"expect":{"error":null,"order":["t1","t2","t3","t4"],"waves":[["t1"],["t4"],["t2"],["t3"]]}},
    {"name":"plan: the first error wins (id before role)","kind":"plan","tasks":[{"id":"x1","owner_role":"docs","files":["/a"]}],"expect":{"error":"task id \"x1\" must look like t1"}},
    {"name":"waves: overlapping files add a wave","kind":"waves","tasks":[{"id":"t1","files":["src/"]},{"id":"t2","files":["src/a.ts"]},{"id":"t3","files":["lib/"]},{"id":"t4","files":["src/*.ts"],"deps":["t3"]}],"expect":{"order":["t1","t2","t3","t4"],"waves":[["t1","t3"],["t2"],["t4"]]}},
    {"name":"waves: shuffled graph","kind":"waves","max_in_flight":1,"tasks":[{"id":"t4","files":["d"],"deps":["t1","t2"]},{"id":"t2","files":["b"]},{"id":"t1","files":["a"]},{"id":"t5","files":["."],"deps":[]},{"id":"t3","files":["c"],"deps":["t4"]}],"expect":{"order":["t1","t2","t4","t5","t3"],"waves":[["t1"],["t2"],["t4"],["t5"],["t3"]]}},
    {"name":"waves: no cap keeps whole waves","kind":"waves","max_in_flight":null,"tasks":[{"id":"t1","files":["a"]},{"id":"t2","files":["b"]},{"id":"t3","files":["c"]},{"id":"t4","files":["d"],"deps":["t1"]}],"expect":{"order":["t1","t2","t3","t4"],"waves":[["t1","t2","t3"],["t4"]]}},
    {"name":"waves: cap three","kind":"waves","max_in_flight":3,"tasks":[{"id":"t1","files":["a"]},{"id":"t2","files":["b"]},{"id":"t3","files":["c"]},{"id":"t4","files":["d"]},{"id":"t5","files":["e"]},{"id":"t6","files":["a/z"],"deps":["t5"]},{"id":"t7","files":["docs/**"]},{"id":"t8","files":["docs/x.md"]}],"expect":{"order":["t1","t2","t3","t4","t5","t6","t7","t8"],"waves":[["t1","t2","t3"],["t4","t5","t7"],["t6","t8"]]}}
  ]
}
